{
  "name": "feishu-card-view-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "飞书多维表格扩展视图插件「卡片视图」（Card View）—— 只读浏览增强视图",
  "license": "UNLICENSED",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "upload": "opdev upload ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lark-base-open/js-sdk": "^1.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@lark-opdev/block-bitable-webpack-utils": "^0.1.7",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.19",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.39",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.6",
    "ts-loader": "^9.5.1",
    "typescript": "~5.3.3",
    "vitest": "^1.6.0",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
